{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 467,
  "height": 300,
  "background": null,
  "view": {"fill": "transparent", "stroke": null},

  "data": {
    "url": "https://raw.githubusercontent.com/xanhnguyen186/3179/main/global_ai_tools_students_use.csv"
  },

  "transform": [
    {
      "fold": [
        "uses_chatgpt","uses_grammarly","uses_gemini",
        "uses_quillbot","uses_notion_ai","uses_phind","uses_edu_chat"
      ],
      "as": ["tool_raw","used"]
    },
    {
      "calculate": "datum.tool_raw == 'uses_chatgpt' ? 'ChatGPT' : datum.tool_raw == 'uses_grammarly' ? 'Grammarly' : datum.tool_raw == 'uses_gemini' ? 'Gemini' : datum.tool_raw == 'uses_quillbot' ? 'QuillBot' : datum.tool_raw == 'uses_notion_ai' ? 'Notion' : datum.tool_raw == 'uses_phind' ? 'Phind' : datum.tool_raw == 'uses_edu_chat' ? 'Educhat' : datum.tool_raw",
      "as": "tool"
    },
    { "calculate": "lower(toString(datum.used)) == 'true' ? 1 : 0", "as": "used_bin" },
    { "aggregate": [{"op":"mean","field":"used_bin","as":"prop_use"}], "groupby": ["grade","tool"] }
  ],

  "layer": [
    {
      "selection": {
        "tool_filter": {
          "type": "point",
          "fields": ["tool"],
          "bind": "legend",
          "empty": "all"
        }
      },
      "mark": { "type": "line", "interpolate": "monotone", "point": true },
      "encoding": {
        "x": { "field": "grade", "type": "ordinal", "sort": ["9th","10th","11th","12th"], "title": "Grade", "axis": {"titlePadding": 10} },
        "y": { "field": "prop_use", "type": "quantitative", "title": "Proportion of Students Using Tool", "axis": {"format": ".0%"} },
        "color": {
          "field": "tool", "type": "nominal", "title": "AI Tool",
          "scale": {
            "domain": ["Gemini","ChatGPT","Grammarly","Phind","QuillBot","Notion","Educhat"],
            "range":  ["#f08080","#fea98e","#a5d6a7","#87cefa","#7986cb","#ce93d8","#f8bbd0"]
          }
        },
        "opacity": {
          "condition": { "selection": "tool_filter", "value": 1 },
          "value": 0.05
        },
        "tooltip": [
          { "field": "tool", "title": "Tool" },
          { "field": "grade", "title": "Grade" },
          { "field": "prop_use", "title": "Proportion", "format": ".1%" }
        ]
      }
    },

    { "data": { "values": [ 
    {"grade": "12th", "note": "Grade 12 students rely more on AI tools for study support"}
  ] 
}, 
    "mark": { "type": "text", "fontSize": 12, "align": "right", "dx": -20}, 
    "encoding": { 
      "x": { "field": "grade", "type": "ordinal", "sort": ["9th","10th","11th","12th"] }, 
      "y": { "value": 193 }, "text": { "field": "note" }, "color": { "value": "white" } } },

      {
        "data": {
          "values": [
            {
            "grade": "11th", "prop_use": 0.14},
            {"grade": "12th", "prop_use": 0.20}

          ]
        },
        "mark": {"type":"line", "strokeWidth": 1, "color": "white"},
  "encoding": {
    "x": { "field": "grade", "type": "ordinal", "sort": ["9th","10th","11th","12th"], "title": "Grade", "axis": {"titlePadding": 10} },
    "y":  { "field": "prop_use", "type": "quantitative", "title": "Proportion of Students Using Tool", "axis": {"format": ".0%", "titlePadding": 10} }
      }},
      
      {
      "data": {"values": [{"grade": "12th"}]},
      "mark": {"type": "rule", "strokeDash": [5,5], "strokeWidth": 2, "color": "#ffffffaa"},
      "encoding": {
        "x": {"field": "grade", "type": "ordinal", "sort": ["9th","10th","11th","12th"]}
      }
    }

      
    
    
    
    ],

    

  "config": {
    "axis": {
      "labelColor": "white",
      "titleColor": "white",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "gridColor": "#7e7e7e",
      "gridOpacity": 0.5
    },
    "legend": {
      "labelColor": "white",
      "titleColor": "white",
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "title": { "color": "white", "fontSize": 16 },
    "header": {
      "labelColor": "white",
      "titleColor": "white",
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "tooltip": { "color": "white", "fontSize": 12 }
  }
}

