{
  "$schema":"https://vega.github.io/schema/vega-lite/v5.json",
  "width": 320,
  "height": 200,
  "background": null,
  "view": {"fill": "transparent", "stroke": null},
  "data":{"url":"https://raw.githubusercontent.com/xanhnguyen186/3179/main/AI_adoption_data2.csv"},
  "transform":[
    {"filter":"datum.year == 2023 || datum.year == 2024"},
    {"filter":"isValid(datum.adoption_rate)"},
    {"calculate":"toNumber(datum.adoption_rate) / 100", "as":"adopt_frac"},
    {"aggregate":[{"op":"mean","field":"adopt_frac","as":"rate"}],"groupby":["industry","year"]},
    {"pivot":"year","value":"rate","groupby":["industry"]},
    {"calculate":"datum['2024'] - datum['2023']","as":"delta"},
    {"calculate":"datum['2023'] * 100","as":"rate_2023"},
    {"calculate":"datum['2024'] * 100","as":"rate_2024"},
    {"calculate":"datum.delta * 100","as":"delta_pct"}   
  ],
  "mark":"bar",
  "encoding":{
    "y":{
      "field":"industry",
      "type":"nominal",
      "sort":{"field":"delta","order":"descending"},
      "title": null
    },
    "x":{
      "field":"delta_pct",
      "type":"quantitative",
      "title":"Change in Adoption Rate (%)",
      "axis":{"format":"+.0f"}
    },
    "color":{
      "condition":{"test":"datum.delta >= 0","value":"#b8d7d5"},
      "value":"#cea0aa"
    },
    "fill": {
      "condition": {
        "test": "datum.delta >= 0",
        "value": {
          "gradient": "linear",
          "x1": 0, "y1": 0, "x2": 1, "y2": 0,
          "stops": [
            {"offset": 0, "color": "#bddeca"},
            {"offset": 1, "color": "#d9e5ab"}
          ]
        }
      },
      "value": {
        "gradient": "linear",
        "x1": 0, "y1": 0, "x2": 1, "y2": 0,
        "stops": [
          {"offset": 0, "color": "#ffc69e"},
          {"offset": 1, "color": "#ffadad"}
        ]
      }
    },
    "tooltip":[
      {"field":"industry", "title": "Industry"},
      {"field":"rate_2023","title":"2023 Rate (%)","format":".1f"},
      {"field":"rate_2024","title":"2024 Rate (%)","format":".1f"},
      {"field":"delta_pct","title":"Change (%)","format":"+.1f"}
    ]
  },
  "config": {
    "axis": {
      "labelColor": "white",
      "titleColor": "white",
      "labelFontSize": 12,
      "gridColor": "#7e7e7e",
      "gridOpacity": 0.5,
      "titleFontSize": 13
    },
    "legend": {
      "labelColor": "white",
      "titleColor": "white",
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "title": {
      "color": "white",
      "fontSize": 16
    },
    "header": {
      "labelColor": "white",
      "titleColor": "white",
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "tooltip": {
      "color": "white",
      "fontSize": 12
    }
  }
}
