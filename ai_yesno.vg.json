{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 250,
  "height": 220,
  "background": null,
  "view": {"fill": "transparent", "stroke": null},

  "data": {
    "url": "https://raw.githubusercontent.com/xanhnguyen186/3179/main/global_ai_tools_students_use.csv"
  },

  "transform": [
    { "filter": "datum.country == 'Australia'" },
    {
      "calculate": "lower(toString(datum.uses_ai_for_study)) == 'true' ? 'Uses AI' : 'Does not use AI'",
      "as": "uses_ai_label"
    },
    {
      "aggregate": [{"op": "count", "as": "count"}],
      "groupby": ["uses_ai_label"]
    },
    { "joinaggregate": [{"op": "sum", "field": "count", "as": "total"}] },
    { "calculate": "datum.count / datum.total", "as": "pct" },
    { "calculate": "datum.pct * 100", "as": "pct100" }
  ],

  "layer": [
    {
      "mark": {"type": "arc", "innerRadius": 65},
      "encoding": {
        "theta": {"field": "count", "type": "quantitative"},
        "fill": {
          "condition": {
            "test": "datum.uses_ai_label === 'Does not use AI'",
            "value": {
              "gradient": "linear",
              "x1": 0, "y1": 0, "x2": 1, "y2": 0,
              "stops": [{"offset": 0,"color": "#ffc69e"},{"offset": 1,"color": "#ffadad"}]
            }
          },
          "value": {
            "gradient": "linear",
            "x1": 0, "y1": 0, "x2": 1, "y2": 0,
            "stops": [
              {"offset": 0, "color": "#b7f6af"},
              {"offset": 1, "color": "#80e8dd"}
            ]
          }
        },
        "tooltip": [
          {"field": "uses_ai_label", "title": "Response"},
          {"field": "count", "title": "Number of Students", "format": ","},
          {"field": "pct100", "title": "Share (%)", "format": ".1f"}
        ]
      }
    },


    {
      "mark": {
        "type": "text",
        "radius": -55,
        "dy": -83,
        "color": "black",
        "fontWeight": "bold"
      },
      "encoding": {
        "theta": {"field": "count", "type": "quantitative"},
        "text": {"field": "pct", "format": ".1%"}
      }
    },

{
  "mark": {"type": "point", "filled": true, "size": 100, "color": "#ffadad"},
  "encoding": {
    "x": {"value": 80},
    "y": {"value": 110}
  }
},
{
  "mark": {"type": "text", "align": "left", "dx": 10, "fontSize": 12, "color": "white"},
  "encoding": {
    "x": {"value": 80},
    "y": {"value": 110},
    "text": {"value": "Does not use AI"}
  }
},

{
  "mark": {"type": "point", "filled": true, "size": 100, "color": "#b7f6af"},
  "encoding": {
    "x": {"value": 100},
    "y": {"value": 95}
  }
},
{
  "mark": {"type": "text", "align": "left", "dx": 10, "fontSize": 12, "color": "white"},
  "encoding": {
    "x": {"value": 100},
    "y": {"value": 95},
    "text": {"value": "Uses AI"}
  }
}


  ],

  "config": {
    "axis": {
      "labelColor": "white",
      "titleColor": "white",
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "legend": {
      "labelColor": "white",
      "titleColor": "white",
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "title": {
      "color": "white",
      "fontSize": 16
    },
    "header": {
      "labelColor": "white",
      "titleColor": "white",
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "tooltip": {
      "color": "white",
      "fontSize": 12
    }
  }
}
